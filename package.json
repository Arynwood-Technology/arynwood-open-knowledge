{
  "name": "arynwood-open-knowledge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run && node server/orcid.test.mjs",
    "test:watch": "vitest",
    "tauri": "npx --no-install tauri",
    "check:desktop": "cargo check --manifest-path src-tauri/Cargo.toml",
    "auth:orcid": "node --env-file=.env server/orcid.mjs",
    "evaluate": "node --experimental-strip-types scripts/evaluate.ts"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "@testing-library/react": "16.3.3",
    "jsdom": "25.0.1",
    "@types/node": "24.19.2"
  }
}
