{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arynwood Open Knowledge",
  "version": "0.1.0",
  "identifier": "com.arynwood.openknowledge",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Arynwood Open Knowledge",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://api.crossref.org https://api.openalex.org; img-src 'self' data:; object-src 'none'; base-uri 'self';"
    }
  },
  "bundle": {
    "active": false
  }
}
