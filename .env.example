# Server-only. Copy to .env, restrict permissions, and use a newly rotated secret.
# Production credentials require HTTPS. For sandbox, register a separate sandbox client.
ORCID_ENV=production
ORCID_CLIENT_ID=APP-XCLFZQGVZXGHE29S
ORCID_CLIENT_SECRET=
ORCID_REDIRECT_URI=https://research.arynwood.com/auth/orcid/callback
# For sandbox local development:
# ORCID_ENV=sandbox
# ORCID_CLIENT_ID=YOUR_SANDBOX_CLIENT_ID
# ORCID_REDIRECT_URI=http://127.0.0.1:8000/auth/orcid/callback
# Optional public frontend link only; VITE_ variables enter the frontend bundle.
# VITE_ORCID_AUTH_URL=http://127.0.0.1:8000/auth/orcid
